{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "types": []
    },
    "include": ["resources/js/**/*.ts", "resources/js/**/*.vue", "tests/js/**/*.ts", "vite.config.ts"]
}
